        <com.mirth.connect.plugins.javascriptstep.JavaScriptStep version="4.5.2">
          <name>Guardar HL7 crudo</name>
          <sequenceNumber>0</sequenceNumber>
          <enabled>true</enabled>
          <script>var rawMessage = connectorMessage.getRawData();
var dbConn = null;

try {
    dbConn = DatabaseConnectionFactory.createDatabaseConnection(
        &apos;org.postgresql.Driver&apos;,
        &apos;jdbc:postgresql://postgres:5432/hl7db&apos;,
        java.lang.System.getenv(&apos;DATABASE_USERNAME&apos;),
        java.lang.System.getenv(&apos;DATABASE_PASSWORD&apos;)
    );

    var parameters = new java.util.ArrayList();
    parameters.add(new java.lang.String(rawMessage));

    dbConn.executeUpdate(
        &quot;INSERT INTO public.hl7_raw_messages (received_at, raw_message) &quot; +
        &quot;VALUES (CURRENT_TIMESTAMP AT TIME ZONE &apos;America/Argentina/Buenos_Aires&apos;, ?)&quot;,
        parameters
    );
} finally {
    if (dbConn !== null) {
        dbConn.close();
    }
}</script>
        </com.mirth.connect.plugins.javascriptstep.JavaScriptStep>
        <com.mirth.connect.plugins.javascriptstep.JavaScriptStep version="4.5.2">
          <name>Crear Patient FHIR</name>
          <sequenceNumber>1</sequenceNumber>
          <enabled>true</enabled>
          <script>var patientId = msg[&apos;PID&apos;][&apos;PID.3&apos;][&apos;PID.3.1&apos;].toString();
var apellido = msg[&apos;PID&apos;][&apos;PID.5&apos;][&apos;PID.5.1&apos;].toString();
var nombre = msg[&apos;PID&apos;][&apos;PID.5&apos;][&apos;PID.5.2&apos;].toString();

if (patientId === &apos;&apos;) {
    throw new Error(&apos;Falta el identificador en PID-3.1&apos;);
}

var patient = {
    resourceType: &apos;Patient&apos;,
    identifier: [
        {
            system: &apos;urn:hl7-poc:his:patient-id&apos;,
            value: patientId
        }
    ],
    name: [
        {
            family: apellido,
            given: [nombre]
        }
    ]
};

channelMap.put(&apos;patientJson&apos;, JSON.stringify(patient));</script>
        </com.mirth.connect.plugins.javascriptstep.JavaScriptStep>
